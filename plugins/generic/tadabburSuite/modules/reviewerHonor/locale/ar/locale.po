msgid "plugins.generic.reviewerHonor.defaultLetter"
msgstr "سعادة الأستاذ الدكتور/ {name}          حفظه الله\nالسلام عليكم ورحمة الله وبركاته، وبعد:\nفيسرّ هيئة تحرير {journal} أن تتقدم لسعادتكم بخالص الشكر والتقدير على إسهامكم العلمي في تحكيم ({count}) من البحوث خلال عام {year}، وما بذلتموه من وقت وجهد في تقويمها وتجويدها، مما كان له أبلغ الأثر في الارتقاء بجودة ما تنشره المجلة.\nسائلين الله أن يجزيكم خير الجزاء، وأن ينفع بعلمكم.\nوتقبلوا خالص التحية والتقدير،،،"

msgid "plugins.generic.reviewerHonor.letterHeading"
msgstr "شكر وتقدير"

msgid "plugins.generic.reviewerHonor.mineIntro"
