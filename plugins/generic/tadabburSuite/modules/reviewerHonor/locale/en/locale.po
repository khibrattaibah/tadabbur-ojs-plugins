msgid "plugins.generic.reviewerHonor.defaultLetter"
msgstr "Dear {name},\nThe editorial board of {journal} is pleased to thank you sincerely for reviewing {count} manuscript(s) during {year}, and for the time and care you devoted to evaluating and improving them, which greatly raised the quality of what the journal publishes.\nWith our best regards."

