msgid "plugins.generic.officialLetters.body.receipt"
msgstr "السلام عليكم ورحمة الله وبركاته، وبعد: فتفيد {$journal} باستلام بحثكم الموسوم بـ«{$title}» بتاريخ {$submitted}، وقد قُيّد برقم ({$id})، وسيخضع للإجراءات العلمية المتبعة في المجلة من الفحص الأولي ثم التحكيم العلمي، وسنوافيكم بما يستجد."

msgid "plugins.generic.officialLetters.body.acceptance"
msgstr "السلام عليكم ورحمة الله وبركاته، وبعد: فتفيد {$journal} بأن البحث الموسوم بـ«{$title}» للباحث/الباحثين: {$authors}، قد اجتاز التحكيم العلمي وأُجيز للنشر بصفة نهائية بتاريخ {$accepted}، وأُعطيت هذه الإفادة بناءً على طلبه."

msgid "plugins.generic.officialLetters.body.publication"
msgstr "السلام عليكم ورحمة الله وبركاته، وبعد: فتشهد {$journal} بأن البحث الموسوم بـ«{$title}» للباحث/الباحثين: {$authors}، قد نُشر بعد تحكيمه علميًا في {$issue} بتاريخ {$published}، وأُعطيت هذه الشهادة بناءً على طلبه."

