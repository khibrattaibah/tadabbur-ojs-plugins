msgid "plugins.generic.officialLetters.name"
msgstr "Verified Official Letters"

msgid "plugins.generic.officialLetters.description"
msgstr "Receipt, final acceptance and publication letters on the journal letterhead, with an outgoing number, Hijri and Gregorian dates, the editor-in-chief signature and stamp, and a QR code to a public verification page. Issued by editors or self-issued by authors once eligible. Developed by Moustafa Mahmoud — Khibrat Taibah for Research and Studies."

msgid "plugins.generic.officialLetters.open"
msgstr "Open letters"

msgid "plugins.generic.officialLetters.menu"
msgstr "Official Letters"

