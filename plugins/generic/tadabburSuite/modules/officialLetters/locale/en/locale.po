msgstr "My Letters"

msgid "plugins.generic.officialLetters.forbidden"
msgstr "You are not allowed to access this page."

msgid "plugins.generic.officialLetters.intro"
msgstr "Pick a submission, then the letter type and language. A blue button issues a new letter; a white one re-downloads the current letter with the same number. Each letter keeps a fixed snapshot of the submission data at issue time and is verifiable by QR code."

msgid "plugins.generic.officialLetters.noMpdf"
msgstr "mPDF is not available on this server; PDFs cannot be generated."

