msgstr "To whom it may concern,"

msgid "plugins.generic.officialLetters.body.receipt"
msgstr "{$journal} acknowledges receipt of your manuscript entitled “{$title}” on {$submitted}, registered under number {$id}. It will undergo the journal’s editorial procedures of initial screening followed by peer review, and we will keep you informed."

msgid "plugins.generic.officialLetters.body.acceptance"
msgstr "{$journal} certifies that the manuscript entitled “{$title}” by {$authors} has passed peer review and was finally accepted for publication on {$accepted}. This letter is issued upon request."

msgid "plugins.generic.officialLetters.body.publication"
msgstr "{$journal} certifies that the peer-reviewed article entitled “{$title}” by {$authors} was published in {$issue} on {$published}. This certificate is issued upon request."

