msgid "plugins.generic.editorialCommand.mail.author.body"
msgstr "حضرة الباحث/ة {$name}، السلام عليكم ورحمة الله وبركاته،\n\nنذكّركم بأن بحثكم «{$title}» (رقم {$id}) بانتظار النسخة المعدلة منذ {$days} يومًا. نرجو رفعها من خلال منصة المجلة مع مصفوفة الرد على ملاحظات المحكّمين، أو إفادتنا بالموعد المتوقع.\n\nمع خالص التقدير،\nهيئة تحرير {$journal}"

