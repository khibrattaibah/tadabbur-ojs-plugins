msgstr "Open Early View"

msgid "plugins.generic.earlyView.menu"
msgstr "Early view"

msgid "plugins.generic.earlyView.intro"
msgstr "Accepted papers (copyediting or production) not yet published. Pick a PDF (copyedited or proof) and tick \"Show\". Add the public page link to the site menu from Settings → Website → Navigation."

