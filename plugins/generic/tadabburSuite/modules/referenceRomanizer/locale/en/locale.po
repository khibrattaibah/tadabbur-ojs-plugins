msgid "plugins.generic.referenceRomanizer.name"
msgstr "Reference Romanizer"

msgid "plugins.generic.referenceRomanizer.description"
msgstr "Detects non-Roman references, proposes ALA-LC romanization and title translations, applies them to the reference list and keeps the Arabic originals on the article page. — Developed by Moustafa Mahmoud — Khibrat Taibah for Research and Studies"

msgid "plugins.generic.referenceRomanizer.menu"
msgstr "Reference Romanization"

