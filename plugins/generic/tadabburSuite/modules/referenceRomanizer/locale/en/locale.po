msgstr "Access denied."

msgid "plugins.generic.referenceRomanizer.notFound"
msgstr "Submission not found."

msgid "plugins.generic.referenceRomanizer.intro"
msgstr "Scopus and Web of Science require references in Roman script. This helper detects Arabic references, proposes a romanization for the editor to review, and applies it to the reference list (deposited to Crossref), while keeping and displaying the Arabic originals."

