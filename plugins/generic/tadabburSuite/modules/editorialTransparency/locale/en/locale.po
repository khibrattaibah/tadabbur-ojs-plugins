msgid "plugins.generic.editorialTransparency.name"
msgstr "Editorial Transparency & Statistics"

msgid "plugins.generic.editorialTransparency.description"
msgstr "A bilingual public page with editorial and peer-review indicators computed from OJS: acceptance/rejection rates, decision, review and publication times, annual output and geographic diversity, with methodology and open JSON data. — Developed by Moustafa Mahmoud — Khibrat Taibah for Research and Studies"

msgid "plugins.generic.editorialTransparency.open"
msgstr "View page (refresh data)"

msgid "plugins.generic.editorialTransparency.title"
msgstr "Editorial Transparency & Performance"

msgid "plugins.generic.editorialTransparency.lead"
msgstr "We are committed to transparency in our editorial processes. The indicators below are computed automatically from our journal management system (OJS), refreshed regularly, and reflect the path of manuscripts from submission to publication."

