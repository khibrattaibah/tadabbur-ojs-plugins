msgid "plugins.generic.editorialTransparency.m.source"
msgstr "Source: the journal’s OJS database; rates use the same method as OJS editorial statistics."

msgid "plugins.generic.editorialTransparency.m.rates"
msgstr "Acceptance/rejection rates: manuscripts submitted in the period that received a final decision. Desk rejection happens before peer review."

msgid "plugins.generic.editorialTransparency.m.times"
msgstr "Times are in days; we show the median (half are faster) and the 80th percentile. Acceptance→publication is computed for articles published in the period."

msgid "plugins.generic.editorialTransparency.m.review"
msgstr "Review turnaround: from invitation to report submission, for invitations issued in the period. Reviewer identities are never shown."

msgid "plugins.generic.editorialTransparency.m.geo"
msgstr "Geography: by the country recorded for each author of articles published in the period."

msgid "plugins.generic.editorialTransparency.m.metrics"
msgstr "Views and downloads follow OJS COUNTER-compliant usage statistics."

