msgid "plugins.generic.scholarBoost.name"
msgstr "Google Scholar Booster"

msgid "plugins.generic.scholarBoost.description"
msgstr "Completes the indexing tags the core Google Scholar plugin adds to each article page: the correct publisher name, second-language keywords, author ORCIDs, the free-full-text flag, and schema.org JSON-LD for Google. It checks every published paper against Scholar's inclusion guidelines (PDF and its size, author names/title/abstract in the paper's language, pages, references, duplicate titles) and checks robots.txt and site access. Developed by Moustafa Mahmoud — Khibrat Taibah."

msgid "plugins.generic.scholarBoost.open"
msgstr "Open Scholar Booster"

msgid "plugins.generic.scholarBoost.menu"
msgstr "Google Scholar"

msgid "plugins.generic.scholarBoost.intro"
msgstr "Google Scholar indexes from the article page and the PDF and silently drops papers that break its guidelines. This check reveals what blocks or weakens inclusion."

