msgid "plugins.generic.arabicIndexes.name"
msgstr "Arabic Indexes Pack"

msgid "plugins.generic.arabicIndexes.description"
msgstr "Exports each issue in the templates of Arabic databases (Dar Al-Mandumah, e-Marefa, Al-Manhal, ARCIF and a custom one) as Excel and CSV, with a references file and a PDF bundle per issue, plus a tracking log of what was sent to each database and what was indexed. Columns are editable to match each database's form. Developed by Moustafa Mahmoud — Khibrat Taibah."

msgid "plugins.generic.arabicIndexes.open"
msgstr "Open Arabic Indexes"

msgid "plugins.generic.arabicIndexes.menu"
msgstr "Arabic indexes"

msgid "plugins.generic.arabicIndexes.intro"
msgstr "For each published issue: export the database file (Excel) and the PDF bundle, then record the sending date and indexing status by clicking the cell. Templates are suggestions; match their columns to each database's form once in Settings."

