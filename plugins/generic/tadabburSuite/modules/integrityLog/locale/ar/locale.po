msgid "plugins.generic.integrityLog.steps.plagiarism"
msgstr "اطلب تقرير التشابه الكامل وحدد حجم النص المنقول ومصدره|قيّم الحالة: نقل محدود مع إسناد ناقص أم انتحال واضح لأفكار أو نصوص|راسل المؤلف المراسل مع الأدلة واطلب توضيحًا مكتوبًا|قيّم الرد: إن كان مقنعًا أو النقل محدودًا فاطلب إعادة الصياغة والإسناد|إن ثبت انتحال جوهري: ارفض البحث، أو اسحبه إن كان منشورًا|عند الحاجة أبلغ جهة انتماء المؤلف، وأبلغ صاحب العمل المنقول|وثّق القرار وأغلق الحالة"

msgid "plugins.generic.integrityLog.steps.duplicate"
msgstr "اجمع نسختي النشر وقارن بين النصوص والبيانات وتواريخ التقديم|راسل المؤلف بالأدلة واطلب تفسيرًا|راسل محرر المجلة الأخرى لتنسيق الإجراء|إن ثبت التكرار: ارفض البحث، أو انشر إشعار نشر مكرر أو اسحبه|أبلغ جهة الانتماء إن تكرر السلوك|وثّق القرار وأغلق الحالة"

msgid "plugins.generic.integrityLog.steps.authorship"
msgstr "اطلب من جميع المؤلفين بيانًا موقّعًا بالموافقة على قائمة المؤلفين وأدوارهم|استمع إلى كل الأطراف واطلب الأدلة على الإسهام|لا تفصل المجلة في النزاع بنفسها: أحِل الخلاف إلى جهة الانتماء عند عدم الاتفاق|أوقف معالجة البحث إلى أن يُحسم النزاع|عند الاتفاق: عدّل قائمة المؤلفين (وانشر تصحيحًا إن كان منشورًا)|وثّق القرار وأغلق الحالة"

msgid "plugins.generic.integrityLog.steps.fabrication"
msgstr "اجمع الأدلة واستشر محكّمًا أو مختصًا مستقلًا|راسل المؤلف بالمخاوف واطلب البيانات الأصلية|إن لم يكن الرد مقنعًا: راسل جهة الانتماء واطلب تحقيقًا|إن كان البحث منشورًا: انشر تعبيرًا عن قلق حتى انتهاء التحقيق|إن ثبت التلفيق: اسحب البحث وأبلغ الجهات المعنية|وثّق القرار وأغلق الحالة"

msgid "plugins.generic.integrityLog.steps.reviewerMisconduct"
msgstr "اجمع الأدلة (تقرير التحكيم، مراسلات، تشابه مع عمل منشور للمحكّم)|راسل المحكّم واطلب تفسيرًا|استبعد المحكّم من البحث، وأعد التحكيم إن لزم|أبلغ المؤلف بما يلزم مع الحفاظ على سرية التحكيم|عند الثبوت: أزل المحكّم من قاعدة المحكّمين وأبلغ جهته إن كان جسيمًا|وثّق القرار وأغلق الحالة"

msgid "plugins.generic.integrityLog.steps.coi"
msgstr "حدد طبيعة المصلحة غير المُفصح عنها وأثرها المحتمل|راسل المؤلف واطلب إفصاحًا كاملًا|قيّم أثرها على نتائج البحث وتحكيمه|انشر الإفصاح (تصحيحًا إن كان البحث منشورًا)|إن أثّرت في سلامة النتائج: تعبير عن قلق أو سحب|وثّق القرار وأغلق الحالة"

msgid "plugins.generic.integrityLog.steps.citationManipulation"
msgstr "حلّل المراجع: استشهاد ذاتي مفرط أو مطلوب من محكّم أو محرر أو تكتل استشهادي|راسل الطرف المعني واطلب تفسيرًا|احذف الاستشهادات غير المسوغة قبل النشر|إن كان من محكّم أو محرر: استبعده من التحكيم|انشر تصحيحًا إن كان البحث منشورًا|وثّق القرار وأغلق الحالة"

msgid "plugins.generic.integrityLog.steps.paperMill"
msgstr "سجّل المؤشرات: نصوص قالبية، بيانات مصطنعة، بريد غير مؤسسي، تقديمات متشابهة|افحص البحوث الأخرى من المؤلفين أنفسهم أو بالنمط نفسه|راسل المؤلف واطلب البيانات الأصلية وإثبات الانتماء|أوقف المعالجة أو ارفض، واسحب إن كان منشورًا مع تعبير عن قلق أثناء التحقق|شارك المعلومات مع الناشرين الآخرين وفق إرشادات COPE وSTM|وثّق القرار وأغلق الحالة"

msgid "plugins.generic.integrityLog.steps.ethics"
msgstr "حدد المخالفة (غياب موافقة أخلاقية، موافقة المشاركين، خصوصية البيانات)|اطلب من المؤلف وثائق الموافقة الأخلاقية|إن غابت الموافقة: راسل جهة الانتماء|قرّر: رفض، أو تصحيح بيان الأخلاقيات، أو سحب|وثّق القرار وأغلق الحالة"

msgid "plugins.generic.integrityLog.steps.other"
msgstr "اجمع المعلومات والأدلة من مصدر البلاغ|راسل الأطراف المعنية واطلب الرد|راجع مسار COPE الأقرب للحالة|اتخذ القرار وأبلغ الأطراف|وثّق القرار وأغلق الحالة"

