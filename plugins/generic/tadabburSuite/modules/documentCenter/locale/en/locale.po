msgid "plugins.generic.documentCenter.tx.rev_thanks.title"
msgstr "Letter of Appreciation"

msgid "plugins.generic.documentCenter.tx.rev_thanks.body"
msgstr "On behalf of {$journal}, we sincerely thank you for the time and expertise you devoted to reviewing the paper entitled “{$title}”. Your careful scholarly comments help us maintain the quality of what the journal publishes."

msgid "plugins.generic.documentCenter.tx.au_apology.title"
msgstr "Letter of Regret"

msgid "plugins.generic.documentCenter.tx.au_apology.body"
msgstr "Thank you for choosing {$journal} for your paper entitled “{$title}” (ID {$id}). After completing the editorial screening and peer review in line with the journal’s policy, we regret to inform you that the paper cannot be accepted for publication."

msgid "plugins.generic.documentCenter.tx.au_apology.hope"
msgstr "We value your scholarly effort, hope the reviewers’ comments help you develop the work, and look forward to your future submissions."

msgid "plugins.generic.documentCenter.tx.au_reviews.title"
msgstr "Reviewer Comments"

msgid "plugins.generic.documentCenter.tx.au_reviews.body"
