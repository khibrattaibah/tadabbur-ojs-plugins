msgid "plugins.generic.quranVerifier.st.ok.d"
msgstr "Text and reference match the Mushaf."

msgid "plugins.generic.quranVerifier.st.diff.d"
msgstr "The text has {$n} difference(s) from the Mushaf ({$correct})."

msgid "plugins.generic.quranVerifier.st.refWrong.d"
msgstr "The text is correct but is found at {$correct}, not {$cited}."

msgid "plugins.generic.quranVerifier.st.refPartial.d"
msgstr "The quoted verses are {$correct}; the reference given is {$cited}."

msgid "plugins.generic.quranVerifier.st.refMissing.d"
msgstr "Text is correct but no reference is given. Location: {$correct}."

msgid "plugins.generic.quranVerifier.st.refInvalid.d"
msgstr "The reference “{$cited}” is invalid (unknown surah or verse out of range). {$correct}"

msgid "plugins.generic.quranVerifier.st.notFound.d"
msgstr "No matching Mushaf text; it may be a hadith or other text in Quranic brackets, or contain many errors. {$correct}"

msgid "plugins.generic.quranVerifier.st.short.d"
msgstr "Quotation too short (under three words) to verify automatically."

msgid "plugins.generic.quranVerifier.h.noNumber"
msgstr "No hadith number or volume/page given."

msgid "plugins.generic.quranVerifier.h.noGrade"
msgstr "No grading given (source is outside the two Sahihs)."

msgid "plugins.generic.quranVerifier.h.noTakhrij"
msgstr "Hadith attributed to the Prophet ﷺ with no referencing in the paragraph or its footnote."

msgid "plugins.generic.quranVerifier.h.ok"
msgstr "Referencing complete"

msgid "plugins.generic.quranVerifier.hadithNote"
msgstr "Hadith checks are formal: they verify that source, number and grading are present, not the authenticity of the text — that remains the specialist reviewer’s role."

msgid "plugins.generic.quranVerifier.method"
msgstr "Method: letters are compared without diacritics (vowelling is not checked); both standard and Uthmani orthography are accepted. Verses are detected in ﴿ ﴾ or { } or when followed by a reference such as [al-Baqarah: 255]; references are read from the text or the footnote."

msgid "plugins.generic.quranVerifier.tanzil"
