msgid "plugins.generic.abstractAssistant.name"
msgstr "Abstract & Metadata Translation Assistant"

msgid "plugins.generic.abstractAssistant.description"
msgstr "Translates titles, abstracts and keywords between Arabic and English with Claude, or language-edits the English version, using a journal glossary. Nothing is applied without editor approval. Developed by Moustafa Mahmoud — Khibrat Taibah for Research and Studies."

