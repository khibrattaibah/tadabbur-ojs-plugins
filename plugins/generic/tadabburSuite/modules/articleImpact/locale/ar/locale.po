msgstr "يعرض في صفحة كل بحث المشاهدات والتنزيلات ومنحنى شهريًا وعدد الاستشهادات (Crossref وOpenAlex) وقائمة «استُشهد به في»، مع لوحة ترتيب للمحررين وتصدير CSV. تطوير: مصطفى محمود — مكتب خبرات طيبة للبحوث والدراسات."

msgid "plugins.generic.articleImpact.open"
msgstr "فتح لوحة التأثير"

msgid "plugins.generic.articleImpact.menu"
msgstr "تأثير البحوث"

msgid "plugins.generic.articleImpact.forbidden"
msgstr "لا تملك صلاحية الوصول إلى هذه الصفحة."

msgid "plugins.generic.articleImpact.blockTitle"
msgstr "مؤشرات البحث"

msgid "plugins.generic.articleImpact.views"
msgstr "مشاهدة"

msgid "plugins.generic.articleImpact.downloads"
msgstr "تنزيل"

msgid "plugins.generic.articleImpact.citations"
